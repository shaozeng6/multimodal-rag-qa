MYSQL_URL=mysql+aiomysql://root:password@localhost:3306/rag_enterprise
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
MILVUS_URI=http://localhost:19530
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=your-api-key
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- 运行调参(schema_v3 起迁移到「系统设置」页, sys_config 表) ----
# 检索召回(topK)/评估阈值/分片字符数/上下文窗口/图片上限等运行调参,
# 在管理员「系统设置」页可视化配置, 落库 sys_config 表并即时生效(hot), 无需改本文件。
# 术语归一化映射表(JSON 文件, {"别名":"标准名"})
RAG_TERM_MAPPING_PATH=

# ---- 基础设施配置(归属 .env, 不在设置页) ----
# 模型型号/温度/维度、OCR、限流等重启级/部署级配置, 由本文件控制(启动时读入)。

# ---- 入库管道(Ingestion) ----
# OCR: dots_ocr 依赖本地 vllm GPU 服务(需先启动, 模型 dots_ocr)
OCR_VLLM_IP=localhost
OCR_VLLM_PORT=6006
OCR_VLLM_MODEL=dots_ocr
# 输出/临时目录(相对 backend 运行目录)
INGEST_OUTPUT_DIR=ingest_output
INGEST_IMAGES_DIR=ingest_output/images
INGEST_TMP_DIR=ingest_tmp
INGEST_OCR_THREADS=16
INGEST_OCR_DPI=200

# ---- 模型与限流(llm_init.py 启动时读取, 重启生效) ----
LLM_MODEL=qwen3.7-plus
MULTIMODAL_LLM_MODEL=qwen3-vl-plus
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_DIMENSIONS=1024
JUDGE_LLM_MODEL=qwen3.7-plus  # 独立评审模型(与生成模型不同系列可消除自评偏置)
DASHSCOPE_RPM_LIMIT=120
DASHSCOPE_WINDOW_SECONDS=60
DASHSCOPE_MAX_IMAGE_BYTES=3145728

# ---- 消息图片存储(schema_v2: base64 落文件, 存引用) ----
# 该目录经 /uploads 静态挂载暴露, 历史消息图片引用为 /uploads/xx.png
UPLOAD_IMAGES_DIR=uploads/images
# 额外允许 /api/files 提供图片的根目录(分号分隔); 旧数据 image_path 可能指向其他目录
# 例: KB_IMAGE_ROOTS=C:/TempGame/Multimodal_RAG/output
KB_IMAGE_ROOTS=
